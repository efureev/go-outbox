# Every setting lives under OUTBOX_. See docs/Config.md for the full reference.

# --- Application -------------------------------------------------------------
OUTBOX_APP_ENV=dev
OUTBOX_LOG_LEVEL=info
OUTBOX_LOG_FORMAT=console          # console | text | json (use json in production)

# --- Database ----------------------------------------------------------------
# Either a DSN, or the components below.
OUTBOX_DB_DSN=postgres://outbox:outbox@localhost:55432/outbox?sslmode=disable
OUTBOX_DB_SCHEMA=outbox
OUTBOX_DB_TABLE=messages
# Off in production: the schema usually belongs to the producer's deployment.
OUTBOX_DB_AUTO_MIGRATE=true

# --- Streams and drivers -----------------------------------------------------
OUTBOX_STREAMS=local,global

OUTBOX_STREAM_LOCAL_DRIVER=rmq
OUTBOX_STREAM_GLOBAL_DRIVER=kfk

OUTBOX_DRIVER_RMQ_TYPE=rabbitmq
OUTBOX_DRIVER_RMQ_DSN=amqp://outbox:outbox@localhost:55672/
OUTBOX_DRIVER_RMQ_PREFIX=dev
# Leave declaration off unless this service owns the broker topology.
OUTBOX_DRIVER_RMQ_DECLARE=true

OUTBOX_DRIVER_KFK_TYPE=kafka
OUTBOX_DRIVER_KFK_BROKERS=localhost:19092
OUTBOX_DRIVER_KFK_PREFIX=dev

# --- Dispatch ----------------------------------------------------------------
OUTBOX_DISPATCH_BATCH_SIZE=200
OUTBOX_DISPATCH_WORKERS=8
OUTBOX_DISPATCH_POLL_INTERVAL=5s
OUTBOX_DISPATCH_LEASE_TTL=2m
OUTBOX_DISPATCH_MAX_ATTEMPTS=5
OUTBOX_DISPATCH_BACKOFF_BASE=1m
OUTBOX_DISPATCH_BACKOFF_MAX=1h

# --- Interfaces --------------------------------------------------------------
OUTBOX_HTTP_PORT=8085
OUTBOX_METRICS_PORT=9100
# Without a token the requeue endpoint is not registered at all.
OUTBOX_HTTP_ADMIN_TOKEN=

# --- Housekeeping ------------------------------------------------------------
OUTBOX_JANITOR_RETENTION=168h
